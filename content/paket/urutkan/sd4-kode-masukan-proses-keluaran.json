  "locale": {
    "id": {
      "judul": "Masukan, Proses, Keluaran",
      "instruksi": "Susun baris program supaya berjalan benar: minta masukan dulu dengan baris minta, olah, lalu tampilkan hasilnya. Tanda == artinya 'sama dengan?'.",
      "s1": "Kalkulator tambah",
      "s1-1": "angka = minta('Angka berapa?')",
      "s1-2": "tambahan = angka + 5",
      "s1-3": "hasil = angka + tambahan",
      "s1-4": "tampilkan hasil",
      "s2": "Kuis satu soal",
      "s2-1": "jawaban = minta('Berapa 3 + 4?')",
      "s2-2": "selisih = jawaban - 7",
      "s2-3": "kalau selisih == 0: pesan = 'Hebat!', kalau tidak: pesan = 'Coba lagi'",
      "s2-4": "tampilkan pesan",
      "s3": "Pengubah suhu",
      "s3-1": "c = minta('Suhu dalam °C?')",
      "s3-2": "f = c * 9 / 5",
      "s3-3": "f = f + 32",
      "s3-4": "tampilkan f",
      "s4": "Sapa pengguna",
      "s4-1": "nama = minta('Siapa namamu?')",
      "s4-2": "sapa = 'Halo, ' + nama",
      "s4-3": "sapa = sapa + '!'",
      "s4-4": "tampilkan sapa",
      "s5": "Luas empat ubin",
      "s5-1": "sisi = minta('Panjang sisi ubin (cm)?')",
      "s5-2": "luas = sisi * sisi",
      "s5-3": "empat = luas * 4",
      "s5-4": "tampilkan empat",
      "s6": "Rata-rata dua nilai",
      "s6-1": "nilai = minta('Berapa nilai ulanganmu?')",
      "s6-2": "bonus = nilai + 10",
      "s6-3": "rata = (nilai + bonus) / 2",
      "s6-4": "tampilkan rata",
      "s7": "Umur tahun depan dalam bulan",
      "s7-1": "umur = minta('Berapa umurmu?')",
      "s7-2": "depan = umur + 1",
      "s7-3": "bulan = depan * 12",
      "s7-4": "tampilkan bulan",
      "s8": "Tabungan seminggu",
      "s8-1": "harian = minta('Uang jajan sehari?')",
      "s8-2": "seminggu = harian * 7",
      "s8-3": "tabung = seminggu / 2",
      "s8-4": "tampilkan tabung",
      "s9": "Jarak lari keliling lapangan",
      "s9-1": "putaran = minta('Berapa putaran?')",
      "s9-2": "meter = putaran * 400",
      "s9-3": "km = meter / 1000",
      "s9-4": "tampilkan km",
      "s10": "Bagi sisa permen berdua",
      "s10-1": "permen = minta('Ada berapa permen?')",
      "s10-2": "sisa = permen - 2",
      "s10-3": "bagian = sisa / 2",
      "s10-4": "tampilkan bagian"
    },
    "en": {
      "judul": "Input, Process, Output",
      "instruksi": "Put the program lines in an order that works: ask for input first with the ask line, process it, then show the result. The sign == means 'equal to?'.",
      "s1": "Adding calculator",
      "s1-1": "number = ask('Which number?')",
      "s1-2": "extra = number + 5",
      "s1-3": "result = number + extra",
      "s1-4": "show result",
      "s2": "One-question quiz",
      "s2-1": "answer = ask('What is 3 + 4?')",
      "s2-2": "gap = answer - 7",
      "s2-3": "if gap == 0: message = 'Great!', else: message = 'Try again'",
      "s2-4": "show message",
      "s3": "Temperature converter",
      "s3-1": "c = ask('Temperature in °C?')",
      "s3-2": "f = c * 9 / 5",
      "s3-3": "f = f + 32",
      "s3-4": "show f",
      "s4": "Greet the user",
      "s4-1": "name = ask('What is your name?')",
      "s4-2": "greeting = 'Hello, ' + name",
      "s4-3": "greeting = greeting + '!'",
      "s4-4": "show greeting",
      "s5": "Area of four tiles",
      "s5-1": "side = ask('Tile side length (cm)?')",
      "s5-2": "area = side * side",
      "s5-3": "four = area * 4",
      "s5-4": "show four",
      "s6": "Mean of two marks",
      "s6-1": "mark = ask('What is your test mark?')",
      "s6-2": "bonus = mark + 10",
      "s6-3": "mean = (mark + bonus) / 2",
      "s6-4": "show mean",
      "s7": "Next year's age in months",
      "s7-1": "age = ask('How old are you?')",
      "s7-2": "next = age + 1",
      "s7-3": "months = next * 12",
      "s7-4": "show months",
      "s8": "Savings for a week",
      "s8-1": "daily = ask('Pocket money per day?')",
      "s8-2": "week = daily * 7",
      "s8-3": "save = week / 2",
      "s8-4": "show save",
      "s9": "Running laps of the field",
      "s9-1": "laps = ask('How many laps?')",
      "s9-2": "metres = laps * 400",
      "s9-3": "km = metres / 1000",
      "s9-4": "show km",
      "s10": "Share the leftover sweets",
      "s10-1": "sweets = ask('How many sweets?')",
      "s10-2": "left = sweets - 2",
      "s10-3": "share = left / 2",
      "s10-4": "show share"
    }
  },
