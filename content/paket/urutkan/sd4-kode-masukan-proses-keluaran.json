  "locale": {
    "id": {
      "judul": "Masukan, Proses, Keluaran",
      "instruksi": "Susun baris program supaya berjalan benar: minta masukan dulu, olah, lalu tampilkan hasilnya.",
      "s1": "Kalkulator tambah",
      "s1-1": "minta angka pertama",
      "s1-2": "minta angka kedua",
      "s1-3": "hasil = pertama + kedua",
      "s1-4": "tampilkan hasil",
      "s2": "Kuis satu soal",
      "s2-1": "tampilkan soal 3 + 4 = ?",
      "s2-2": "minta jawaban",
      "s2-3": "kalau jawaban 7, skor = skor + 1",
      "s2-4": "tampilkan skor",
      "s3": "Pengubah suhu",
      "s3-1": "c = suhu °C dari pengguna",
      "s3-2": "f = c * 9 / 5",
      "s3-3": "f = f + 32",
      "s3-4": "tampilkan f dalam °F",
      "s4": "Sapa pengguna",
      "s4-1": "tampilkan 'Siapa namamu?'",
      "s4-2": "nama = jawaban pengguna",
      "s4-3": "sapa = 'Halo, ' + nama",
      "s4-4": "tampilkan sapa",
      "s5": "Luas persegi",
      "s5-1": "tampilkan 'Panjang sisi?'",
      "s5-2": "sisi = angka dari pengguna",
      "s5-3": "luas = sisi * sisi",
      "s5-4": "tampilkan luas",
      "s6": "Rata-rata tiga nilai",
      "s6-1": "minta nilai n1, n2, n3",
      "s6-2": "jumlah = n1 + n2 + n3",
      "s6-3": "rata = jumlah / 3",
      "s6-4": "tampilkan rata",
      "s7": "Umur tahun depan",
      "s7-1": "tampilkan 'Berapa umurmu?'",
      "s7-2": "umur = angka dari pengguna",
      "s7-3": "umur = umur + 1",
      "s7-4": "tampilkan umur",
      "s8": "Uang jajan seminggu",
      "s8-1": "tampilkan 'Uang jajan sehari?'",
      "s8-2": "harian = angka dari pengguna",
      "s8-3": "seminggu = harian * 7",
      "s8-4": "tampilkan seminggu",
      "s9": "Menit jadi detik",
      "s9-1": "tampilkan 'Berapa menit?'",
      "s9-2": "m = angka dari pengguna",
      "s9-3": "d = m * 60",
      "s9-4": "tampilkan d detik",
      "s10": "Bagi permen berdua",
      "s10-1": "tampilkan 'Ada berapa permen?'",
      "s10-2": "permen = angka dari pengguna",
      "s10-3": "bagian = permen / 2",
      "s10-4": "tampilkan bagian"
    },
    "en": {
      "judul": "Input, Process, Output",
      "instruksi": "Put the program lines in an order that works: ask for input first, process it, then show the result.",
      "s1": "Adding calculator",
      "s1-1": "ask for the first number",
      "s1-2": "ask for the second number",
      "s1-3": "result = first + second",
      "s1-4": "show result",
      "s2": "One-question quiz",
      "s2-1": "show the question 3 + 4 = ?",
      "s2-2": "ask for the answer",
      "s2-3": "if answer is 7, score = score + 1",
      "s2-4": "show score",
      "s3": "Temperature converter",
      "s3-1": "c = temperature in °C from the user",
      "s3-2": "f = c * 9 / 5",
      "s3-3": "f = f + 32",
      "s3-4": "show f in °F",
      "s4": "Greet the user",
      "s4-1": "show 'What is your name?'",
      "s4-2": "name = the user's answer",
      "s4-3": "greeting = 'Hello, ' + name",
      "s4-4": "show greeting",
      "s5": "Area of a square",
      "s5-1": "show 'Side length?'",
      "s5-2": "side = number from the user",
      "s5-3": "area = side * side",
      "s5-4": "show area",
      "s6": "Mean of three marks",
      "s6-1": "ask for marks m1, m2, m3",
      "s6-2": "total = m1 + m2 + m3",
      "s6-3": "mean = total / 3",
      "s6-4": "show mean",
      "s7": "Age next year",
      "s7-1": "show 'How old are you?'",
      "s7-2": "age = number from the user",
      "s7-3": "age = age + 1",
      "s7-4": "show age",
      "s8": "Pocket money for a week",
      "s8-1": "show 'Pocket money per day?'",
      "s8-2": "daily = number from the user",
      "s8-3": "week = daily * 7",
      "s8-4": "show week",
      "s9": "Minutes to seconds",
      "s9-1": "show 'How many minutes?'",
      "s9-2": "m = number from the user",
      "s9-3": "s = m * 60",
      "s9-4": "show s seconds",
      "s10": "Share sweets between two",
      "s10-1": "show 'How many sweets?'",
      "s10-2": "sweets = number from the user",
      "s10-3": "share = sweets / 2",
      "s10-4": "show share"
    }
  },
