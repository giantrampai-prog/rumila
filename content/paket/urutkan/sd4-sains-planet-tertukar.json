      "x-venus": "Venus (yellow, covered in thick clouds)",
      "x-bumi": "Earth (blue-green, our home)",
      "x-mars": "Mars (red and dusty)",
      "x-jupiter": "Jupiter (striped giant, the biggest)",
      "x-saturnus": "Saturn (with wide rings)",
      "x-uranus": "Uranus (pale blue, spins on its side)",
      "x-neptunus": "Neptune (deep blue, very windy)",
      "t-semua": "Solar system model: from closest to the Sun"
    }
