      "x-bumi": "Bumi (biru-hijau, rumah kita)",
      "x-mars": "Mars (merah berdebu)",
      "x-jupiter": "Jupiter (raksasa bergaris, paling besar)",
      "x-saturnus": "Saturnus (bercincin lebar)",
      "x-uranus": "Uranus (biru muda, berputar miring)",
      "x-neptunus": "Neptunus (biru tua, berangin kencang)",
      "t-semua": "Model tata surya: dari yang paling dekat Matahari"
    },
    "en": {
      "judul": "Mixed-Up Planets",
