  "locale": {
    "id": {
      "judul": "Perjalanan Sebuah Pesan",
      "instruksi": "Susun perjalanan data dari perangkat pengirim, lewat jaringan, sampai ke penerima.",
      "s1": "Pesan ke teman",
      "s1-1": "kamu mengetik dan menekan kirim",
      "s1-2": "HP mengirim lewat Wi-Fi ke router",
      "s1-3": "router meneruskan ke internet",
      "s1-4": "server aplikasi pesan menerima",
      "s1-5": "server mengirim ke HP temanmu",
      "s2": "Menonton video",
      "s2-1": "kamu mengetuk sebuah video",
      "s2-2": "permintaan dikirim ke server video",
      "s2-3": "server mengirim video dalam potongan kecil (paket)",
      "s2-4": "paket tiba dan disusun lagi",
      "s2-5": "video diputar di layarmu",
      "s3": "Mengirim email",
      "s3-1": "kamu menulis email lalu menekan kirim",
      "s3-2": "email dipecah jadi paket-paket",
      "s3-3": "paket lewat beberapa router",
      "s3-4": "paket disusun lagi di server penerima",
      "s3-5": "penerima membuka email",
      "s4": "Mencetak lewat Wi-Fi",
      "s4-1": "kamu menekan Cetak di laptop",
      "s4-2": "laptop mengirim berkas ke router",
      "s4-3": "router meneruskan ke printer",
      "s4-4": "printer mencetak halaman",
      "s5": "Panggilan video",
      "s5-1": "kamera merekam wajahmu",
      "s5-2": "gambar dipecah jadi paket",
      "s5-3": "paket dikirim lewat internet",
      "s5-4": "HP temanmu menyusun paketnya",
      "s5-5": "wajahmu muncul di layar temanmu"
    },
    "en": {
      "judul": "A Message's Journey",
      "instruksi": "Put the data's journey in order, from the sending device, through the network, to the receiver.",
      "s1": "A message to a friend",
      "s1-1": "you type and press send",
      "s1-2": "the phone sends it over Wi-Fi to the router",
      "s1-3": "the router passes it to the internet",
      "s1-4": "the messaging app's server receives it",
      "s1-5": "the server sends it to your friend's phone",
      "s2": "Watching a video",
      "s2-1": "you tap a video",
      "s2-2": "a request goes to the video server",
      "s2-3": "the server sends the video in small pieces (packets)",
      "s2-4": "the packets arrive and are put back together",
      "s2-5": "the video plays on your screen",
      "s3": "Sending an email",
      "s3-1": "you write an email and press send",
      "s3-2": "the email is split into packets",
      "s3-3": "the packets travel through several routers",
      "s3-4": "the packets are put back together at the receiver's server",
      "s3-5": "the receiver opens the email",
      "s4": "Printing over Wi-Fi",
      "s4-1": "you press Print on the laptop",
      "s4-2": "the laptop sends the file to the router",
      "s4-3": "the router passes it to the printer",
      "s4-4": "the printer prints the page",
      "s5": "Video call",
      "s5-1": "the camera records your face",
      "s5-2": "the picture is split into packets",
      "s5-3": "the packets are sent across the internet",
      "s5-4": "your friend's phone puts the packets together",
      "s5-5": "your face appears on your friend's screen"
    }
  },
