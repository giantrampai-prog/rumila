    "en": {
      "judul": "Melting and Freezing All Around",
      "instruksi": "Put the melting and freezing steps in order from start to finish. Remember, the substance stays the same even when its state changes.",
      "t-kaca": "Broken glass made into bottles",
      "kaca-a": "solid pieces of glass are collected",
      "kaca-b": "heated in a very hot furnace",
      "kaca-c": "the glass melts into a thick liquid",
      "kaca-d": "shaped, then cooled into a solid glass bottle",
      "t-besi": "Iron cast into a fence",
      "besi-a": "solid pieces of iron",
      "besi-b": "melted in the factory furnace",
      "besi-c": "the liquid iron is poured into a mould",
      "besi-d": "it cools and freezes into an iron fence",
      "t-plastik": "Plastic pellets made into buckets",
      "plastik-a": "solid plastic pellets in a sack",
      "plastik-b": "heated inside the machine",
      "plastik-c": "the plastic melts into a liquid",
      "plastik-d": "moulded and cooled into a solid bucket",
      "t-lem": "A glue gun used to stick cardboard",
      "lem-a": "a solid glue stick goes into the gun",
      "lem-b": "the glue stick is heated inside the gun",
      "lem-c": "the glue comes out as a liquid",
      "lem-d": "the glue cools and hardens again",
      "t-solder": "Solder joins two wires",
      "solder-a": "a solid wire of solder",
      "solder-b": "touched with the hot soldering iron",
      "solder-c": "the solder melts into liquid drops",
      "solder-d": "the solder cools, hardens, and joins the wires",
      "t-lava": "A volcano erupts",
      "lava-a": "hot liquid rock inside the volcano",
      "lava-b": "the liquid rock comes out as lava",
      "lava-c": "the lava flows and starts to cool",
      "lava-d": "the lava freezes into solid rock",
      "t-kutub": "An ice block in the polar sea",
      "kutub-a": "a solid block of ice floats",
      "kutub-b": "summer comes, the air warms up",
      "kutub-c": "the ice melts little by little",
      "kutub-d": "the ice becomes liquid water; it is still water",
      "t-botol": "A bottle of water in the freezer",
      "botol-a": "liquid water in a bottle",
      "botol-b": "the bottle stays in the freezer overnight",
      "botol-c": "the water freezes into solid ice",
      "botol-d": "taken out, the ice melts back into the same water",
      "t-salju": "Snow on a roof",
      "salju-a": "solid snow piles up on the roof",
      "salju-b": "in the morning the sun shines warmly",
      "salju-c": "the snow melts and drips",
      "salju-d": "only liquid water is left in the gutter",
