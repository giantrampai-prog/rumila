  "locale": {
    "id": {
      "judul": "Kerja Tim dengan Versi Kode",
      "instruksi": "Ada dua langkah yang tertukar dalam alur kerja tim ini: temukan lalu tukar sekali saja supaya urutannya benar.",
      "s1": "Menambah fitur baru",
      "s1-1": "ambil versi terbaru dari tim (pull)",
      "s1-2": "buat cabang untuk fiturmu (branch)",
      "s1-3": "ubah kodenya",
      "s1-4": "uji programnya",
      "s1-5": "simpan dengan pesan jelas (commit)",
      "s1-6": "kirim ke repositori tim (push)",
      "s2": "Memperbaiki bug",
      "s2-1": "baca laporan bug",
      "s2-2": "ambil versi terbaru (pull)",
      "s2-3": "cari baris penyebabnya",
      "s2-4": "perbaiki lalu uji",
      "s2-5": "commit: 'perbaiki tombol simpan'",
      "s2-6": "minta teman memeriksa",
      "s3": "Memeriksa kerja teman",
      "s3-1": "teman mengirim perubahan",
      "s3-2": "baca perubahan baris demi baris",
      "s3-3": "jalankan dan uji",
      "s3-4": "beri komentar dan saran",
      "s3-5": "gabungkan ke versi utama (merge)",
      "s4": "Menyelesaikan bentrok",
      "s4-1": "dua orang mengubah baris yang sama",
      "s4-2": "git menandai bentrok (conflict)",
      "s4-3": "diskusikan versi mana yang dipakai",
      "s4-4": "rapikan baris yang bentrok",
      "s4-5": "commit hasil gabungan",
      "s5": "Memulai proyek",
      "s5-1": "buat folder proyek",
      "s5-2": "jalankan git init",
      "s5-3": "tulis kode pertama",
      "s5-4": "commit pertama",
      "s5-5": "unggah ke repositori tim"
    },
    "en": {
      "judul": "Teamwork with Code Versions",
      "instruksi": "Two steps in this team workflow are swapped: find them and swap once so the order is right.",
      "s1": "Adding a new feature",
      "s1-1": "get the team's latest version (pull)",
      "s1-2": "make a branch for your feature",
      "s1-3": "change the code",
      "s1-4": "test the program",
      "s1-5": "save it with a clear message (commit)",
      "s1-6": "send it to the team repository (push)",
      "s2": "Fixing a bug",
      "s2-1": "read the bug report",
      "s2-2": "get the latest version (pull)",
      "s2-3": "find the line causing it",
      "s2-4": "fix it and test",
      "s2-5": "commit: 'fix save button'",
      "s2-6": "ask a teammate to review",
      "s3": "Reviewing a teammate's work",
      "s3-1": "a teammate sends changes",
      "s3-2": "read the changes line by line",
      "s3-3": "run and test it",
      "s3-4": "leave comments and suggestions",
      "s3-5": "join it into the main version (merge)",
      "s4": "Sorting out a conflict",
      "s4-1": "two people change the same line",
      "s4-2": "git marks a conflict",
      "s4-3": "discuss which version to keep",
      "s4-4": "tidy the clashing lines",
      "s4-5": "commit the merged result",
      "s5": "Starting a project",
      "s5-1": "make a project folder",
      "s5-2": "run git init",
      "s5-3": "write the first code",
      "s5-4": "first commit",
      "s5-5": "upload to the team repository"
    }
  },
  "knobs": {
    "steps": {
      "min": 5,
      "max": 6,
