  "locale": {
    "id": {
      "judul": "Minta dan Jawab lewat API",
      "instruksi": "Aplikasi meminta data ke server lewat API: susun dari permintaan sampai hasilnya tampil di layar.",
      "s1": "Aplikasi cuaca",
      "s1-1": "kamu memilih kota Bandung",
      "s1-2": "aplikasi mengirim permintaan ke API cuaca",
      "s1-3": "server mencari data cuaca Bandung",
      "s1-4": "server mengirim jawaban: 24°C, berawan",
      "s1-5": "aplikasi menampilkan 24°C ☁️",
      "s2": "Aplikasi terjemahan",
      "s2-1": "kamu mengetik 'cat'",
      "s2-2": "aplikasi mengirim kata itu ke API terjemahan",
      "s2-3": "server menerjemahkan kata",
      "s2-4": "server mengirim jawaban 'kucing'",
      "s2-5": "aplikasi menampilkan 'kucing'",
      "s3": "Aplikasi peta",
      "s3-1": "kamu memilih tujuan: perpustakaan",
      "s3-2": "aplikasi meminta rute ke API peta",
      "s3-3": "server menghitung rute terpendek",
      "s3-4": "server mengirim daftar belokan",
      "s3-5": "aplikasi menggambar rute di peta",
      "s4": "Papan skor game",
      "s4-1": "game selesai dengan skor 120",
      "s4-2": "game mengirim skor ke API papan skor",
      "s4-3": "server menyimpan skor dan menyusun peringkat",
      "s4-4": "server mengirim peringkat terbaru",
      "s4-5": "game menampilkan peringkatmu",
      "s5": "Tombol fakta acak",
      "s5-1": "kamu menekan tombol 'Fakta acak'",
      "s5-2": "aplikasi mengirim permintaan ke API fakta",
      "s5-3": "server memilih satu fakta",
      "s5-4": "server mengirim teks fakta itu",
      "s5-5": "fakta muncul di layar"
    },
    "en": {
      "judul": "Request and Response via an API",
      "instruksi": "An app asks a server for data through an API: put the steps in order from the request until the result appears on screen.",
      "s1": "Weather app",
      "s1-1": "you choose the city Bandung",
      "s1-2": "the app sends a request to the weather API",
      "s1-3": "the server looks up Bandung's weather",
      "s1-4": "the server replies: 24°C, cloudy",
      "s1-5": "the app shows 24°C ☁️",
      "s2": "Translation app",
      "s2-1": "you type 'kucing'",
      "s2-2": "the app sends the word to the translation API",
      "s2-3": "the server translates the word",
      "s2-4": "the server replies 'cat'",
      "s2-5": "the app shows 'cat'",
      "s3": "Map app",
      "s3-1": "you choose a destination: the library",
      "s3-2": "the app asks the map API for a route",
      "s3-3": "the server works out the shortest route",
      "s3-4": "the server sends a list of turns",
      "s3-5": "the app draws the route on the map",
      "s4": "Game leaderboard",
      "s4-1": "the game ends with a score of 120",
      "s4-2": "the game sends the score to the leaderboard API",
      "s4-3": "the server saves the score and ranks it",
      "s4-4": "the server sends the latest ranking",
      "s4-5": "the game shows your rank",
      "s5": "Random fact button",
      "s5-1": "you press the 'Random fact' button",
      "s5-2": "the app sends a request to the facts API",
      "s5-3": "the server picks one fact",
      "s5-4": "the server sends that fact's text",
      "s5-5": "the fact appears on screen"
    }
  },
