  "competencyIds": [
    "KODE.SD4.IPO.01"
  ],
  "instructionKey": "instruksi",
  "locale": {
    "id": {
      "judul": "Program Kasir Pasar",
      "instruksi": "Baris program kasir pasar teracak: susun supaya masukan diminta lebih dulu, lalu diolah dua kali, dan hasilnya ditampilkan terakhir.",
      "s1": "Belanja jeruk",
      "s1-1": "jumlah = minta('Beli berapa jeruk?')",
      "s1-2": "harga = jumlah * 2000",
      "s1-3": "kembali = 10000 - harga",
      "s1-4": "tampilkan kembali",
      "s2": "Umur lima tahun lagi",
      "s2-1": "tahun = minta('Tahun berapa kamu lahir?')",
      "s2-2": "umur = 2026 - tahun",
      "s2-3": "nanti = umur + 5",
      "s2-4": "tampilkan nanti",
      "s3": "Beras dibungkus",
      "s3-1": "kg = minta('Berapa kg beras?')",
      "s3-2": "gram = kg * 1000",
      "s3-3": "bungkus = gram / 250",
      "s3-4": "tampilkan bungkus",
      "s4": "Tiang pagar kebun",
      "s4-1": "sisi = minta('Panjang sisi kebun (meter)?')",
      "s4-2": "keliling = sisi * 4",
      "s4-3": "tiang = keliling / 2",
      "s4-4": "tampilkan tiang",
      "s5": "Jam jadi detik",
      "s5-1": "jam = minta('Berapa jam?')",
      "s5-2": "menit = jam * 60",
      "s5-3": "detik = menit * 60",
      "s5-4": "tampilkan detik",
      "s6": "Telur yang utuh",
      "s6-1": "lusin = minta('Berapa lusin telur?')",
      "s6-2": "butir = lusin * 12",
      "s6-3": "utuh = butir - 3",
      "s6-4": "tampilkan utuh",
      "s7": "Tabungan sebulan",
      "s7-1": "saku = minta('Uang saku sehari?')",
      "s7-2": "tabung = saku / 2",
      "s7-3": "sebulan = tabung * 30",
      "s7-4": "tampilkan sebulan",
      "s8": "Potongan kue untuk empat anak",
      "s8-1": "kue = minta('Ada berapa kue?')",
      "s8-2": "potong = kue * 8",
      "s8-3": "per_anak = potong / 4",
      "s8-4": "tampilkan per_anak",
      "s9": "Langkah ke pasar",
      "s9-1": "jarak = minta('Berapa km ke pasar?')",
      "s9-2": "meter = jarak * 1000",
      "s9-3": "langkah = meter * 2",
      "s9-4": "tampilkan langkah",
      "s10": "Bintang kuis",
      "s10-1": "benar = minta('Berapa soal yang benar?')",
      "s10-2": "skor = benar * 10",
      "s10-3": "bintang = skor / 20",
      "s10-4": "tampilkan bintang",
      "s11": "Air minum hari ini",
      "s11-1": "gelas = minta('Berapa gelas air hari ini?')",
      "s11-2": "ml = gelas * 250",
      "s11-3": "liter = ml / 1000",
      "s11-4": "tampilkan liter",
      "s12": "Sewa sepeda",
      "s12-1": "menit = minta('Berapa menit kamu bersepeda?')",
      "s12-2": "jam = menit / 60",
      "s12-3": "bayar = jam * 5000",
      "s12-4": "tampilkan bayar"
    },
    "en": {
      "judul": "Market Cashier Programs",
      "instruksi": "The market cashier's program lines are mixed up: put them in order so the input is asked for first, then worked on twice, and the result is shown last.",
      "s1": "Buying oranges",
      "s1-1": "count = ask('How many oranges?')",
      "s1-2": "price = count * 2000",
      "s1-3": "change = 10000 - price",
      "s1-4": "show change",
      "s2": "Age in five years",
      "s2-1": "year = ask('What year were you born?')",
      "s2-2": "age = 2026 - year",
      "s2-3": "later = age + 5",
      "s2-4": "show later",
      "s3": "Packing rice",
      "s3-1": "kg = ask('How many kg of rice?')",
      "s3-2": "grams = kg * 1000",
      "s3-3": "packs = grams / 250",
      "s3-4": "show packs",
      "s4": "Garden fence posts",
      "s4-1": "side = ask('Garden side length (metres)?')",
      "s4-2": "perimeter = side * 4",
      "s4-3": "posts = perimeter / 2",
      "s4-4": "show posts",
      "s5": "Hours to seconds",
      "s5-1": "hours = ask('How many hours?')",
      "s5-2": "minutes = hours * 60",
      "s5-3": "seconds = minutes * 60",
      "s5-4": "show seconds",
      "s6": "Unbroken eggs",
      "s6-1": "dozens = ask('How many dozen eggs?')",
      "s6-2": "eggs = dozens * 12",
      "s6-3": "whole = eggs - 3",
      "s6-4": "show whole",
      "s7": "A month of saving",
      "s7-1": "pocket = ask('Pocket money per day?')",
      "s7-2": "save = pocket / 2",
      "s7-3": "month = save * 30",
      "s7-4": "show month",
      "s8": "Cake slices for four children",
      "s8-1": "cakes = ask('How many cakes?')",
      "s8-2": "slices = cakes * 8",
      "s8-3": "each = slices / 4",
      "s8-4": "show each",
      "s9": "Steps to the market",
      "s9-1": "distance = ask('How many km to the market?')",
      "s9-2": "metres = distance * 1000",
      "s9-3": "steps = metres * 2",
      "s9-4": "show steps",
      "s10": "Quiz stars",
      "s10-1": "right = ask('How many answers were right?')",
      "s10-2": "score = right * 10",
      "s10-3": "stars = score / 20",
      "s10-4": "show stars",
      "s11": "Water drunk today",
      "s11-1": "glasses = ask('How many glasses of water today?')",
      "s11-2": "ml = glasses * 250",
      "s11-3": "litres = ml / 1000",
      "s11-4": "show litres",
      "s12": "Bike rental",
      "s12-1": "minutes = ask('How many minutes did you ride?')",
      "s12-2": "hours = minutes / 60",
      "s12-3": "pay = hours * 5000",
      "s12-4": "show pay"
    }
  },
