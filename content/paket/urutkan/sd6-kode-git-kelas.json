  "competencyIds": [
    "KODE.SD6.GIT.01"
  ],
  "instructionKey": "instruksi",
  "locale": {
    "id": {
      "judul": "Alur Tim Kode Kelas",
      "instruksi": "Tim kode kelas selalu bekerja dengan urutan: ambil, cabang, ubah, uji, commit, kirim. Dua langkah di sini tertukar: temukan, lalu tukar sekali saja.",
      "s1": "Menambah level baru",
      "s1-1": "ambil versi terbaru dari tim (pull)",
      "s1-2": "buat cabang 'level-baru' (branch)",
      "s1-3": "gambar peta level 5 dan tulis kodenya",
      "s1-4": "mainkan level 5 untuk menguji",
      "s1-5": "simpan dengan pesan 'tambah level 5' (commit)",
      "s1-6": "kirim ke repositori tim (push)",
      "s2": "Memperbaiki salah ketik",
      "s2-1": "ambil versi terbaru dari tim (pull)",
      "s2-2": "buat cabang 'salah-ketik' (branch)",
      "s2-3": "ganti 'Mulaii' menjadi 'Mulai' di menu",
      "s2-4": "buka menu dan periksa tulisannya",
      "s2-5": "commit: 'perbaiki salah ketik menu'",
      "s2-6": "kirim ke repositori tim (push)",
      "s3": "Mengganti warna tombol",
      "s3-1": "ambil versi terbaru dari tim (pull)",
      "s3-2": "buat cabang 'warna-tombol' (branch)",
      "s3-3": "ubah warna tombol Simpan menjadi hijau",
      "s3-4": "jalankan aplikasi dan lihat tombolnya",
      "s3-5": "commit: 'tombol simpan hijau'",
      "s3-6": "kirim ke repositori tim (push)",
      "s4": "Menambah lagu latar",
      "s4-1": "ambil versi terbaru dari tim (pull)",
      "s4-2": "buat cabang 'lagu-latar' (branch)",
      "s4-3": "tambahkan berkas lagu dan kode pemutarnya",
      "s4-4": "uji: lagu terdengar saat game mulai",
      "s4-5": "commit: 'tambah lagu latar'",
      "s4-6": "kirim ke repositori tim (push)",
      "s5": "Memperbarui terjemahan",
      "s5-1": "ambil versi terbaru dari tim (pull)",
      "s5-2": "buat cabang 'terjemahan' (branch)",
      "s5-3": "ubah teks terjemahan bahasa Inggris",
      "s5-4": "uji: ganti bahasa lalu baca menunya",
      "s5-5": "commit: 'perbarui terjemahan'",
      "s5-6": "kirim ke repositori tim (push)",
      "s6": "Mempercepat program",
      "s6-1": "ambil versi terbaru dari tim (pull)",
      "s6-2": "buat cabang 'lebih-cepat' (branch)",
      "s6-3": "ganti bagian kode yang lambat",
      "s6-4": "ukur lagi: program jalan 2 kali lebih cepat",
      "s6-5": "commit: 'percepat pencarian'",
      "s6-6": "kirim ke repositori tim (push)",
      "s7": "Menulis petunjuk",
      "s7-1": "ambil versi terbaru dari tim (pull)",
      "s7-2": "buat cabang 'petunjuk' (branch)",
      "s7-3": "tulis cara menjalankan program di README",
      "s7-4": "minta teman mencoba petunjuknya",
      "s7-5": "commit: 'tambah petunjuk'",
      "s7-6": "kirim ke repositori tim (push)",
      "s8": "Tombol suara yang diam",
      "s8-1": "ambil versi terbaru dari tim (pull)",
      "s8-2": "buat cabang 'perbaiki-suara' (branch)",
      "s8-3": "perbaiki kode tombol suara",
      "s8-4": "tekan tombolnya: suara terdengar",
      "s8-5": "commit: 'perbaiki tombol suara'",
      "s8-6": "kirim ke repositori tim (push)",
      "s9": "Perbaikan cepat",
      "s9-1": "ambil versi terbaru dari tim (pull)",
      "s9-2": "buat cabang 'perbaikan-cepat' (branch)",
      "s9-3": "perbaiki baris yang membuat error",
      "s9-4": "jalankan lagi: tidak ada error",
      "s9-5": "commit: 'perbaiki error saat dibuka'",
      "s9-6": "kirim ke repositori tim (push)",
      "s10": "Menambah soal kuis",
      "s10-1": "ambil versi terbaru dari tim (pull)",
      "s10-2": "buat cabang 'soal-baru' (branch)",
      "s10-3": "tulis 5 soal baru",
      "s10-4": "coba jawab semua soal baru",
      "s10-5": "commit: 'tambah 5 soal'",
      "s10-6": "kirim ke repositori tim (push)",
      "s11": "Memperbesar huruf judul",
      "s11-1": "ambil versi terbaru dari tim (pull)",
      "s11-2": "buat cabang 'huruf-besar' (branch)",
      "s11-3": "perbesar ukuran huruf judul",
      "s11-4": "periksa tampilannya di HP dan laptop",
      "s11-5": "commit: 'huruf judul lebih besar'",
      "s11-6": "kirim ke repositori tim (push)"
    },
    "en": {
      "judul": "The Class Code Team Workflow",
      "instruksi": "The class code team always works in this order: get, branch, change, test, commit, send. Two steps here are swapped: find them, then swap them just once.",
      "s1": "Adding a new level",
      "s1-1": "get the latest version from the team (pull)",
      "s1-2": "make a branch 'level-baru' (branch)",
      "s1-3": "draw the level 5 map and write its code",
      "s1-4": "play level 5 to test it",
      "s1-5": "save with the message 'add level 5' (commit)",
      "s1-6": "send it to the team repository (push)",
      "s2": "Fixing a typo",
      "s2-1": "get the latest version from the team (pull)",
      "s2-2": "make a branch 'salah-ketik' (branch)",
      "s2-3": "change 'Strat' to 'Start' in the menu",
      "s2-4": "open the menu and check the text",
      "s2-5": "commit: 'fix menu typo'",
      "s2-6": "send it to the team repository (push)",
      "s3": "Changing a button colour",
      "s3-1": "get the latest version from the team (pull)",
      "s3-2": "make a branch 'warna-tombol' (branch)",
      "s3-3": "change the Save button to green",
      "s3-4": "run the app and look at the button",
      "s3-5": "commit: 'green save button'",
      "s3-6": "send it to the team repository (push)",
      "s4": "Adding background music",
      "s4-1": "get the latest version from the team (pull)",
      "s4-2": "make a branch 'lagu-latar' (branch)",
      "s4-3": "add the music file and the code to play it",
      "s4-4": "test: the music plays when the game starts",
      "s4-5": "commit: 'add background music'",
      "s4-6": "send it to the team repository (push)",
      "s5": "Updating a translation",
      "s5-1": "get the latest version from the team (pull)",
      "s5-2": "make a branch 'terjemahan' (branch)",
      "s5-3": "edit the English translation text",
      "s5-4": "test: switch the language and read the menu",
      "s5-5": "commit: 'update translation'",
      "s5-6": "send it to the team repository (push)",
      "s6": "Making the program faster",
      "s6-1": "get the latest version from the team (pull)",
      "s6-2": "make a branch 'lebih-cepat' (branch)",
      "s6-3": "replace the slow part of the code",
      "s6-4": "measure again: the program runs twice as fast",
      "s6-5": "commit: 'speed up search'",
      "s6-6": "send it to the team repository (push)",
      "s7": "Writing instructions",
      "s7-1": "get the latest version from the team (pull)",
      "s7-2": "make a branch 'petunjuk' (branch)",
      "s7-3": "write how to run the program in the README",
      "s7-4": "ask a friend to try the instructions",
      "s7-5": "commit: 'add instructions'",
      "s7-6": "send it to the team repository (push)",
      "s8": "The silent sound button",
      "s8-1": "get the latest version from the team (pull)",
      "s8-2": "make a branch 'perbaiki-suara' (branch)",
      "s8-3": "fix the sound button code",
      "s8-4": "press the button: the sound plays",
      "s8-5": "commit: 'fix sound button'",
      "s8-6": "send it to the team repository (push)",
      "s9": "A quick fix",
      "s9-1": "get the latest version from the team (pull)",
      "s9-2": "make a branch 'perbaikan-cepat' (branch)",
      "s9-3": "fix the line that causes the error",
      "s9-4": "run it again: no errors",
      "s9-5": "commit: 'fix error on opening'",
      "s9-6": "send it to the team repository (push)",
      "s10": "Adding quiz questions",
      "s10-1": "get the latest version from the team (pull)",
      "s10-2": "make a branch 'soal-baru' (branch)",
      "s10-3": "write 5 new questions",
      "s10-4": "try answering all the new questions",
      "s10-5": "commit: 'add 5 questions'",
      "s10-6": "send it to the team repository (push)",
      "s11": "Making the title bigger",
      "s11-1": "get the latest version from the team (pull)",
      "s11-2": "make a branch 'huruf-besar' (branch)",
      "s11-3": "make the title font bigger",
      "s11-4": "check how it looks on a phone and a laptop",
      "s11-5": "commit: 'bigger title font'",
      "s11-6": "send it to the team repository (push)"
    }
  },
