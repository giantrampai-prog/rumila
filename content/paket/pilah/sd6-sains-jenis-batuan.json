      "i-granit": "granit: kristal besar berbintik",
      "i-basalt": "basalt: gelap, dari lava yang cepat dingin",
      "i-apung": "batu apung: ringan dan penuh lubang udara",
      "i-obsidian": "obsidian: hitam mengkilap seperti kaca",
      "i-pasir": "batu pasir: butir pasir terasa kasar",
      "i-kapur": "batu kapur: sering berisi fosil kerang",
      "i-serpih": "batu serpih: lapisan lumpur tipis",
      "i-konglomerat": "konglomerat: kerikil bulat terekat",
      "i-marmer": "marmer: dari batu kapur, berurat halus",
      "i-sabak": "batu sabak: dari serpih, bisa dibelah tipis",
      "i-kuarsit": "kuarsit: dari batu pasir, sangat keras",
      "i-gneis": "gneis: bergaris pita terang-gelap"
    },
    "en": {
      "judul": "Rock Detective",
      "instruksi": "Read each rock's features, then put it with its type: igneous, sedimentary or metamorphic.",
