      "b-sedimen": "sedimentary: layers of settled bits",
      "b-metamorf": "metamorphic: changed by heat and pressure",
      "i-granit": "granite: big speckled crystals",
      "i-basalt": "basalt: dark, from fast-cooling lava",
      "i-apung": "pumice: light and full of air holes",
      "i-obsidian": "obsidian: shiny black like glass",
      "i-pasir": "sandstone: you can feel the sand grains",
      "i-kapur": "limestone: often holds shell fossils",
      "i-serpih": "shale: thin layers of mud",
      "i-konglomerat": "conglomerate: round pebbles cemented together",
      "i-marmer": "marble: made from limestone, finely veined",
      "i-sabak": "slate: made from shale, splits into thin sheets",
      "i-kuarsit": "quartzite: made from sandstone, very hard",
