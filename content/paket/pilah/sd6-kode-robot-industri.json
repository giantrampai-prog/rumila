  "locale": {
    "id": {
      "judul": "Robot di Pabrik",
      "instruksi": "Pikirkan apa yang dikerjakan robot dengan baik di industri, lalu pilih jawaban yang paling tepat.",
      "pilihan": "pilihan",
      "c1": "mengulang gerakan sama persis tanpa lelah",
      "c2": "robot lebih pintar dari semua manusia",
      "c3": "robot tidak butuh listrik",
      "q1": "Mengapa pabrik mobil memakai robot untuk mengelas?",
      "c4": "mengecat ribuan pintu mobil dengan rapi",
      "c5": "menghibur teman yang sedih",
      "c6": "memilih menu baru restoran",
      "q2": "Tugas mana yang paling cocok untuk robot pabrik?",
      "c7": "bahan tidak banyak disentuh tangan",
      "c8": "robot suka makan",
      "c9": "robot tidak perlu dibersihkan",
      "q3": "Di pabrik makanan, robot membantu menjaga kebersihan karena…",
      "c10": "supaya pekerja tidak berada di tempat berbahaya",
      "c11": "robot tidak bisa rusak",
      "c12": "supaya lebih lambat",
      "q4": "Mengapa robot dipakai untuk memeriksa pipa di tempat yang sangat panas?",
      "c13": "pekerja tidak cedera karena mengangkat berat",
      "c14": "kotaknya jadi lebih ringan",
      "c15": "gudang tidak butuh listrik",
      "q5": "Robot di gudang memindahkan kotak berat sepanjang hari. Manfaat utamanya adalah…",
      "c16": "lebih banyak barang dibuat dalam sehari",
      "c17": "barang jadi gratis",
      "c18": "tidak ada yang perlu dirawat",
      "q6": "Pabrik memakai robot yang bekerja siang dan malam. Akibatnya…",
      "c19": "sangat tepat (presisi)",
      "c20": "bisa merasa bosan",
      "c21": "tidak butuh program",
      "q7": "Robot memasang baut pada ponsel sampai ukuran sepersekian milimeter. Ini menunjukkan robot…",
      "c22": "memprogram, memeriksa, dan merawat robot",
      "c23": "tidak ada sama sekali",
      "c24": "menjadi robot",
      "q8": "Apa yang tetap perlu dikerjakan manusia di pabrik yang memakai robot?",
      "c25": "alat masukan (sensor)",
      "c26": "alat keluaran",
      "c27": "tempat menyimpan buah",
      "q9": "Robot pemetik buah memakai kamera untuk mencari buah matang. Kamera itu adalah…",
      "c28": "mutunya rata dan bisa diandalkan",
      "c29": "semua mobil berwarna sama",
      "c30": "mobil tidak perlu bensin",
      "q10": "Mobil yang dirakit robot hampir semuanya sama persis. Manfaatnya adalah…",
      "c31": "kotak berisi kurang atau lebih",
      "c32": "kue jadi kurang manis",
      "c33": "toko tutup lebih awal",
      "q11": "Robot mengemas kue ke kotak dengan jumlah tepat 12 tiap kotak. Kekeliruan apa yang berkurang?",
      "c34": "melindungi pekerja dari bahan berbahaya",
      "c35": "bahan kimia jadi aman dimakan",
      "c36": "robot menyukai bahan kimia",
      "q12": "Mengapa robot dipakai di pabrik baterai yang memakai bahan kimia berbahaya?"
    },
    "en": {
      "judul": "Robots in Factories",
      "instruksi": "Think about what robots do well in industry, then choose the best answer.",
      "pilihan": "choices",
      "c1": "they repeat exactly the same move without tiring",
      "c2": "robots are cleverer than all people",
      "c3": "robots need no electricity",
      "q1": "Why do car factories use robots for welding?",
      "c4": "neatly painting thousands of car doors",
      "c5": "cheering up a sad friend",
      "c6": "choosing a restaurant's new menu",
      "q2": "Which task suits a factory robot best?",
      "c7": "the food is touched less by hands",
      "c8": "robots like eating",
      "c9": "robots never need cleaning",
      "q3": "In a food factory, robots help keep things clean because…",
      "c10": "so workers stay out of danger",
      "c11": "robots cannot break",
      "c12": "to make it slower",
      "q4": "Why are robots used to check pipes in very hot places?",
      "c13": "workers avoid injury from heavy lifting",
      "c14": "the boxes get lighter",
      "c15": "the warehouse needs no power",
      "q5": "Warehouse robots move heavy boxes all day. The main benefit is…",
      "c16": "more goods are made in a day",
      "c17": "goods become free",
      "c18": "nothing needs maintenance",
      "q6": "A factory uses robots that work day and night. As a result…",
      "c19": "very precise",
      "c20": "able to feel bored",
      "c21": "in no need of a program",
      "q7": "Robots fit screws in phones to a fraction of a millimetre. This shows robots are…",
      "c22": "program, check and maintain the robots",
      "c23": "nothing at all",
      "c24": "become robots",
      "q8": "What do people still need to do in a factory that uses robots?",
      "c25": "an input device (sensor)",
      "c26": "an output device",
      "c27": "a place to store fruit",
      "q9": "A fruit-picking robot uses a camera to find ripe fruit. The camera is…",
      "c28": "quality is even and reliable",
      "c29": "every car is the same colour",
      "c30": "cars need no fuel",
      "q10": "Cars built by robots come out almost exactly the same. The benefit is…",
      "c31": "boxes with too few or too many",
      "c32": "cakes being less sweet",
      "c33": "shops closing early",
      "q11": "A robot packs exactly 12 cakes into each box. What mistake becomes rarer?",
      "c34": "to protect workers from harmful chemicals",
      "c35": "so the chemicals become safe to eat",
      "c36": "robots like chemicals",
      "q12": "Why are robots used in battery factories with dangerous chemicals?"
    }
  },
