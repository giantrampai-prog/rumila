# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Data mentah model 3D anatomi (ratusan MB), terlalu besar untuk git
/sources/

# Independent local anatomy QA build and generated browser evidence
/.next-anatomy-qa/
/.playwright-cli/
/sources/anatomy/uncompressed/
/sources/anatomy/*.blend1

.next-anatomy-build/

# build ukur lokal (RUMILA_DIST_DIR)
/.next-prod/

# hasil tangkapan layar & keluaran QA lokal (bukan sumber)
/output/
/supabase/.temp/

# Isolated fruit module production check
/.next-fruits-build/
/.next-3000/

# Isolated Jelajah Angkasa production verification
/.next-angkasa-build/
